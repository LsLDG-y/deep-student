{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["../src/*"],
      "@app-public/*": ["../public/*"]
    }
  },
  "include": ["src"]
}
