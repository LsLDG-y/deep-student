{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "declaration-no-important": true,
    "max-nesting-depth": 3,
    "selector-max-specificity": "0,4,2",
    "no-descending-specificity": null,
    "at-rule-no-unknown": [true, {
      "ignoreAtRules": ["theme", "custom-variant", "apply", "layer", "tailwind", "import"]
    }],
    "import-notation": null,
    "function-no-unknown": [true, {
      "ignoreFunctions": ["theme", "hsl", "color-mix", "oklch"]
    }]
  },
  "overrides": [
    {
      "files": [
        "src/shared/styles/deep-student.css",
        "src/components/crepe/CrepeEditor.css",
        "src/features/chat/styles/chat-beautify.css"
      ],
      "rules": {
        "declaration-no-important": null
      }
    },
    {
      "files": ["src/styles/native-feel/**/*.css"],
      "rules": {
        "declaration-no-important": null,
        "property-no-vendor-prefix": null,
        "selector-no-vendor-prefix": null,
        "selector-class-pattern": null,
        "alpha-value-notation": null,
        "comment-empty-line-before": null
      }
    },
    {
      "comment": "启动面：类名必须与 index.html 静态占位符逐字一致（BEM 由交接契约决定，不是命名偏好）；mask 需要 -webkit- 前缀与 !important 才能覆盖老 Android WebView。",
      "files": ["public/boot.css"],
      "rules": {
        "declaration-no-important": null,
        "property-no-vendor-prefix": null,
        "selector-class-pattern": null,
        "selector-max-specificity": null,
        "comment-empty-line-before": null,
        "rule-empty-line-before": null
      }
    }
  ]
}
